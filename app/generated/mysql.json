{
  "id": "mysql",
  "name": "MySQL Assets",
  "logo": "https://www.mysql.com/common/logos/mysql-logo.svg",
  "config": {
    "properties": {
      "extraction-method": {
        "type": "conditional",
        "required": true,
        "ui": {
          "widget": "radio",
          "label": "Extraction method",
          "hidden": false,
          "help": "Determines the method the package will use to extract metadata.",
          "grid": 8
        },
        "default": "direct",
        "conditions": [
          {
            "property": "labFlag",
            "value": "SECURE_AGENT_EXTRACTION",
            "enum": [
              "direct",
              "agent"
            ],
            "enumNames": [
              "Direct",
              "Agent"
            ]
          }
        ],
        "enum": [
          "direct"
        ],
        "enumNames": [
          "Direct"
        ]
      },
      "credential-guid": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "credential",
          "label": "",
          "hidden": false,
          "help": "",
          "placeholder": "Credential Guid",
          "grid": 8,
          "credentialType": "atlan-connectors-mysql",
          "isTestAuthenticationDisabled": false
        }
      },
      "agent-json": {
        "type": "object",
        "required": false,
        "ui": {
          "widget": "agent",
          "label": "",
          "hidden": false,
          "help": "",
          "placeholder": "Agent JSON",
          "grid": 8,
          "agentConfigs": [
            [
              "atlan-connectors-mysql",
              {
                "properties": {
                  "auth-type": {
                    "enum": [
                      "basic",
                      "iam_user",
                      "iam_role"
                    ],
                    "enumNames": [
                      "Basic",
                      "IAM User",
                      "IAM Role"
                    ]
                  },
                  "basic": {
                    "properties": {
                      "username": {
                        "default": "",
                        "ui": {
                          "placeholder": "Store Credential Path"
                        }
                      },
                      "password": {
                        "default": "",
                        "ui": {
                          "widget": "",
                          "placeholder": "Store Credential Path"
                        }
                      }
                    }
                  },
                  "iam_user": {
                    "properties": {
                      "username": {
                        "default": "",
                        "ui": {
                          "placeholder": "AWS Access Key (Store Path)"
                        }
                      },
                      "password": {
                        "default": "",
                        "ui": {
                          "widget": "",
                          "placeholder": "AWS Secret (Store Path)"
                        }
                      },
                      "extra": {
                        "properties": {
                          "username": {
                            "default": "",
                            "ui": {
                              "placeholder": "MySQL DB User (Store Path)"
                            }
                          }
                        }
                      }
                    }
                  },
                  "iam_role": {
                    "properties": {
                      "username": {
                        "default": "",
                        "ui": {
                          "placeholder": "MySQL DB User (Store Path)"
                        }
                      },
                      "extra": {
                        "properties": {
                          "aws_role_arn": {
                            "default": "",
                            "ui": {
                              "placeholder": "IAM Role ARN (Store Path)"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ],
            [
              "atlan-connectors-agent"
            ]
          ]
        }
      },
      "connection": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "connection",
          "label": "",
          "hidden": false,
          "help": "",
          "placeholder": "Connection Name",
          "grid": 8
        }
      },
      "include-filter": {
        "type": "object",
        "required": false,
        "ui": {
          "widget": "sqltree",
          "label": "Include Metadata",
          "hidden": false,
          "help": "",
          "grid": 4,
          "connectorConfigName": "atlan-connectors-mysql",
          "credential": "credential-guid",
          "sql": "show atlan schemas",
          "schemaExcludePattern": [
            "^performance_schema$",
            "^information_schema.*",
            "^mysql$",
            "^sys$",
            "^METRICS_SCHEMA.*"
          ],
          "description": "Only selected databases and schemas will be extracted. Exclude takes precedence over include for common schemas."
        },
        "additionalProperties": {
          "type": "array"
        },
        "default": "{}"
      },
      "exclude-filter": {
        "type": "object",
        "required": false,
        "ui": {
          "widget": "sqltree",
          "label": "Exclude Metadata",
          "hidden": false,
          "help": "",
          "grid": 4,
          "connectorConfigName": "atlan-connectors-mysql",
          "credential": "credential-guid",
          "sql": "show atlan schemas",
          "schemaExcludePattern": [
            "^performance_schema$",
            "^information_schema.*",
            "^mysql$",
            "^sys$",
            "^METRICS_SCHEMA.*"
          ],
          "description": "Selected schemas wont be extracted."
        },
        "additionalProperties": {
          "type": "array"
        },
        "default": "{}"
      },
      "exclude-table-regex": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "input",
          "label": "Exclude regex for tables & views",
          "hidden": false,
          "help": "Regular expression to exclude temporary tables and views.",
          "placeholder": ".*_TMP|.*_TEMP|TMP:*|TEMP:*",
          "grid": 8
        }
      },
      "preflight-check": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "sageV2",
          "label": "",
          "hidden": false,
          "help": "",
          "grid": 8,
          "config": [
            {
              "id": 1,
              "name": "preflightCheck",
              "title": "MySQL instance preflight check",
              "loaderText": "Checking MySQL instance accessibility and permissions"
            }
          ]
        }
      }
    },
    "anyOf": [
      {
        "properties": {
          "extraction-method": {
            "const": "direct"
          }
        },
        "required": [
          "credential-guid",
          "include-filter",
          "exclude-filter",
          "preflight-check"
        ]
      }
    ],
    "steps": [
      {
        "title": "Credential",
        "description": "",
        "id": "credential",
        "properties": [
          "extraction-method",
          "credential-guid",
          "agent-json"
        ]
      },
      {
        "title": "Connection",
        "description": "",
        "id": "connection",
        "properties": [
          "connection"
        ]
      },
      {
        "title": "Metadata",
        "description": "",
        "id": "metadata",
        "properties": [
          "include-filter",
          "exclude-filter",
          "exclude-table-regex",
          "preflight-check"
        ]
      }
    ]
  }
}
