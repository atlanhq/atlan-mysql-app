{
    "id": "mysql",
    "name": "MySQL",
    "logo": "https://www.mysql.com/common/logos/mysql-logo.svg",
    "config": {
        "properties": {
            "connection": {
                "type": "string",
                "required": false,
                "ui": {
                    "widget": "connection",
                    "label": "",
                    "placeholder": "Connection Name"
                }
            },
            "credential-guid": {
                "type": "string",
                "ui": {
                    "widget": "credential",
                    "label": "",
                    "credentialType": "atlan-connectors-mysql",
                    "placeholder": "Credential Guid",
                    "hidden": false
                }
            },
            "include-filter": {
                "type": "object",
                "additionalProperties": {
                    "type": "array"
                },
                "default": "{}",
                "ui": {
                    "widget": "sqltree",
                    "sql": "show atlan schemas",
                    "connectorConfigName": "atlan-connectors-mysql",
                    "credential": "credential-guid",
                    "label": "Include Metadata",
                    "description": "Only selected databases and schemas will be extracted. Exclude takes precedence over include for common schemas.",
                    "help": "Only selected databases and schemas will be extracted.",
                    "schemaExcludePattern": ["^performance_schema$", "^information_schema.*", "^mysql$", "^sys$", "^METRICS_SCHEMA.*"],
                    "databaseExcludePattern": [],
                    "grid": 4
                }
            },
            "exclude-filter": {
                "type": "object",
                "additionalProperties": {
                    "type": "array"
                },
                "default": "{}",
                "ui": {
                    "widget": "sqltree",
                    "sql": "show atlan schemas",
                    "connectorConfigName": "atlan-connectors-mysql",
                    "credential": "credential-guid",
                    "label": "Exclude Metadata",
                    "description": "Selected schemas wont be extracted.",
                    "help": "Selected schemas wont be extracted.",
                    "schemaExcludePattern": ["^performance_schema$", "^information_schema.*", "^mysql$", "^sys$", "^METRICS_SCHEMA.*"],
                    "databaseExcludePattern": [],
                    "grid": 4
                }
            },
            "exclude-table-regex": {
                "type": "string",
                "required": false,
                "ui": {
                    "label": "Exclude regex for tables & views",
                    "help": "Regular expression to exclude temporary tables and views. Example: .*_TMP|.*_TEMP|TMP:*|TEMP:*",
                    "placeholder": ".*_TMP|.*_TEMP|TMP:*|TEMP:*",
                    "grid": 8
                }
            },
            "preflight-check": {
                "type": "string",
                "ui": {
                    "widget": "sage",
                    "config": [
                        {
                            "id": 1,
                            "name": "preflightCheck",
                            "extraUrlParam": "",
                            "optional": false,
                            "title": "MySQL instance preflight check",
                            "loaderText": "Checking MySQL instance accessibility and permissions"
                        }
                    ]
                }
            }
        },
        "steps": [
            {
                "id": "credential",
                "title": "Credential",
                "description": "Credential Details",
                "properties": [
                    "credential-guid"
                ]
            },
            {
                "id": "connection",
                "title": "Connection",
                "description": "Connection Details",
                "properties": [
                    "connection"
                ]
            },
            {
                "id": "metadata",
                "title": "Metadata",
                "description": "Metadata Filters",
                "properties": [
                    "include-filter",
                    "exclude-filter",
                    "exclude-table-regex",
                    "preflight-check"
                ]
            }
        ]
    }
}
