{
    "id": "mysql",
    "name": "MySQL",
    "logo": "https://www.mysql.com/common/logos/mysql-logo.svg",
    "config": {
        "properties": {
            "connection": {
                "type": "string",
                "required": false,
                "ui": {
                    "widget": "connection",
                    "label": "",
                    "placeholder": "Connection Name"
                }
            },
            "credential-guid": {
                "type": "string",
                "ui": {
                    "widget": "credential",
                    "label": "",
                    "credentialType": "atlan-connectors-mysql",
                    "placeholder": "Credential Guid",
                    "hidden": false
                }
            },
            "include-metadata": {
                "type": "object",
                "additionalProperties": {
                    "type": "array"
                },
                "default": "{}",
                "ui": {
                    "widget": "apitree",
                    "connectorConfigName": "atlan-connectors-mysql",
                    "credential": "credential-guid",
                    "label": "Include Metadata",
                    "description": "Selected databases and schemas will be processed.",
                    "help": "Selected databases and schemas will be processed.",
                    "grid": 4
                }
            },
            "exclude-metadata": {
                "type": "object",
                "additionalProperties": {
                    "type": "array"
                },
                "default": "{}",
                "ui": {
                    "widget": "apitree",
                    "connectorConfigName": "atlan-connectors-mysql",
                    "credential": "credential-guid",
                    "label": "Exclude Metadata",
                    "description": "Selected databases and schemas will not be processed.",
                    "help": "Selected databases and schemas will not be processed.",
                    "grid": 4
                }
            },
            "exclude-table-regex": {
                "type": "string",
                "required": false,
                "ui": {
                    "label": "Exclude regex for tables & views",
                    "help": "Regular expression to exclude temporary tables and views. Example: .*_TMP|.*_TEMP|TMP:*|TEMP:*",
                    "placeholder": ".*_TMP|.*_TEMP|TMP:*|TEMP:*",
                    "grid": 8
                }
            },
            "preflight-check": {
                "type": "string",
                "ui": {
                    "widget": "sage",
                    "config": [
                        {
                            "id": 1,
                            "name": "preflightCheck",
                            "extraUrlParam": "",
                            "optional": false,
                            "title": "MySQL instance preflight check",
                            "loaderText": "Checking MySQL instance accessibility and permissions"
                        }
                    ]
                }
            },
            "advanced-config": {
                "type": "string",
                "enum": ["default", "custom"],
                "default": "default",
                "required": true,
                "enumNames": ["Default", "Advanced"],
                "ui": {
                    "widget": "radio",
                    "hidden": false,
                    "label": "Advanced Config",
                    "help": "Set advanced configuration of the crawler"
                }
            },
            "control-config-strategy": {
                "type": "string",
                "enum": ["default", "custom"],
                "default": "default",
                "required": true,
                "enumNames": ["Default", "Custom"],
                "ui": {
                    "widget": "radio",
                    "hidden": false,
                    "label": "Control Config",
                    "help": "Controls custom feature flags for the crawler"
                }
            },
            "control-config": {
                "type": "string",
                "ui": {
                    "label": "Custom Config",
                    "help": "Custom JSON config. Example: {\"clonedInformationSchema\": \"atlan_meta\"}",
                    "placeholder": "{\"clonedInformationSchema\": \"atlan_meta\"}",
                    "hidden": false,
                    "default": "{}"
                }
            }
        },
        "steps": [
            {
                "id": "credential",
                "title": "Credential",
                "description": "Credential Details",
                "properties": [
                    "credential-guid"
                ]
            },
            {
                "id": "connection",
                "title": "Connection",
                "description": "Connection Details",
                "properties": [
                    "connection"
                ]
            },
            {
                "id": "metadata",
                "title": "Metadata",
                "description": "Metadata Filters",
                "properties": [
                    "include-metadata",
                    "exclude-metadata",
                    "exclude-table-regex",
                    "advanced-config",
                    "control-config-strategy",
                    "control-config",
                    "preflight-check"
                ]
            }
        ],
        "anyOf": [
            {
                "properties": { "advanced-config": { "const": "default" } }
            },
            {
                "properties": { "advanced-config": { "const": "custom" } },
                "required": ["control-config-strategy"]
            },
            {
                "properties": {
                    "advanced-config": { "const": "custom" },
                    "control-config-strategy": { "const": "custom" }
                },
                "required": ["control-config"]
            }
        ]
    }
}
