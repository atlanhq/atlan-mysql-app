{
    "config": {
        "properties": {
            "name": {
                "type": "string",
                "required": false,
                "ui": {
                    "label": "Name",
                    "hidden": true,
                    "placeholder": "Name"
                }
            },
            "connector": {
                "type": "string",
                "default": "mysql",
                "required": false,
                "ui": {
                    "label": "Connector",
                    "hidden": true,
                    "placeholder": "Connector"
                }
            },
            "connectorType": {
                "type": "string",
                "required": false,
                "ui": {
                    "key": "_host",
                    "label": "connectorType",
                    "placeholder": "connectorType",
                    "hidden": true
                }
            },
            "host": {
                "type": "string",
                "required": true,
                "default": "",
                "ui": {
                    "label": "Host",
                    "help": "MySQL server hostname, e.g. database-1.abc123xyz.us-east-1.rds.amazonaws.com",
                    "placeholder": "database-1.abc123xyz.us-east-1.rds.amazonaws.com",
                    "hidden": false,
                    "rules": [
                        {
                            "required": true,
                            "message": "Please enter a valid host name"
                        }
                    ],
                    "grid": 8
                }
            },
            "port": {
                "type": "string",
                "required": true,
                "default": "3306",
                "ui": {
                    "label": "Port",
                    "help": "MySQL server port (default: 3306)",
                    "placeholder": "3306",
                    "hidden": false,
                    "rules": [
                        {
                            "required": true,
                            "message": "Please enter a valid port number"
                        }
                    ],
                    "grid": 4
                }
            },
            "database": {
                "type": "string",
                "required": false,
                "ui": {
                    "label": "Database",
                    "help": "Optional: Default database name. MySQL connections can be established without specifying a database.",
                    "placeholder": "Optional database name",
                    "hidden": false,
                    "grid": 4
                }
            },
            "auth-type": {
                "type": "string",
                "enum": ["basic", "iam_user", "iam_role"],
                "default": "basic",
                "required": true,
                "enumNames": ["Basic", "IAM User", "IAM Role"],
                "ui": {
                    "widget": "radio",
                    "label": "Authentication",
                    "placeholder": "Authentication Type",
                    "hidden": false,
                    "rules": [
                        {
                            "required": true,
                            "message": "Please select an authentication type"
                        }
                    ]
                }
            },
            "basic": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "required": true,
                        "ui": {
                            "label": "Username",
                            "help": "MySQL database username",
                            "placeholder": "Username",
                            "grid": 6,
                            "rules": [
                                {
                                    "required": true,
                                    "message": "Please enter a valid username"
                                }
                            ]
                        }
                    },
                    "password": {
                        "type": "string",
                        "required": true,
                        "ui": {
                            "widget": "password",
                            "label": "Password",
                            "help": "MySQL database password",
                            "placeholder": "Password",
                            "grid": 6,
                            "rules": [
                                {
                                    "required": true,
                                    "message": "Please enter a valid password"
                                }
                            ]
                        }
                    }
                },
                "ui": {
                    "widget": "nested",
                    "label": "Basic Authentication",
                    "nestedValue": false,
                    "hidden": true
                }
            },
            "iam_user": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "required": true,
                        "ui": {
                            "label": "AWS Access Key",
                            "placeholder": "Access Key",
                            "help": "AWS Access Key",
                            "feedback": true,
                            "message": "Please enter a valid Access Key",
                            "grid": 4,
                            "rules": [
                                {
                                    "required": true,
                                    "message": "Please enter a valid Access Key"
                                }
                            ]
                        }
                    },
                    "password": {
                        "type": "string",
                        "required": true,
                        "ui": {
                            "widget": "password",
                            "label": "AWS Secret Key",
                            "help": "AWS Secret Key",
                            "feedback": true,
                            "placeholder": "Secret Key",
                            "grid": 4,
                            "rules": [
                                {
                                    "required": true,
                                    "message": "Please enter a valid Secret Key"
                                }
                            ]
                        }
                    },
                    "extra": {
                        "type": "object",
                        "properties": {
                            "username": {
                                "type": "string",
                                "required": true,
                                "default": "",
                                "ui": {
                                    "label": "Username",
                                    "placeholder": "Username",
                                    "help": "DB Username",
                                    "feedback": true,
                                    "message": "Please enter a valid DB username",
                                    "grid": 4,
                                    "rules": [
                                        {
                                            "required": true,
                                            "message": "Please enter a valid DB username"
                                        }
                                    ]
                                }
                            }
                        },
                        "ui": {
                            "widget": "nested",
                            "label": "",
                            "header": "Advanced",
                            "hidden": false
                        }
                    }
                },
                "ui": {
                    "widget": "nested",
                    "label": "IAM User Authentication",
                    "placeholder": "Credential Type",
                    "nestedValue": false,
                    "hidden": true
                }
            },
            "iam_role": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "required": true,
                        "default": "",
                        "ui": {
                            "label": "Username",
                            "placeholder": "Username",
                            "help": "DB Username",
                            "feedback": true,
                            "message": "Please enter a valid DB username",
                            "grid": 4,
                            "rules": [
                                {
                                    "required": true,
                                    "message": "Please enter a valid DB username"
                                }
                            ]
                        }
                    },
                    "extra": {
                        "type": "object",
                        "properties": {
                            "aws_role_arn": {
                                "type": "string",
                                "required": true,
                                "ui": {
                                    "label": "AWS Role ARN",
                                    "hidden": false,
                                    "placeholder": "arn:aws:iam::123456789012:role/roleName",
                                    "help": "AWS role to assume for the connection",
                                    "grid": 4,
                                    "rules": [
                                        {
                                            "pattern": "^arn:aws:iam::\\d{12}:role/.+",
                                            "message": "Please enter a valid role ARN",
                                            "trigger": "blur"
                                        }
                                    ]
                                }
                            },
                            "aws_external_id": {
                                "type": "string",
                                "required": false,
                                "ui": {
                                    "label": "AWS External ID",
                                    "hidden": false,
                                    "placeholder": "12345678-1234-1234-1234",
                                    "help": "AWS External ID",
                                    "grid": 4,
                                    "rules": [
                                        {
                                            "message": "Please enter a valid external ID",
                                            "trigger": "blur"
                                        }
                                    ]
                                }
                            }
                        },
                        "ui": {
                            "widget": "nested",
                            "label": "",
                            "header": "Advanced",
                            "hidden": false
                        }
                    }
                },
                "ui": {
                    "widget": "nested",
                    "label": "IAM Role Authentication",
                    "nestedValue": false,
                    "hidden": true
                }
            }
        },
        "anyOf": [
            {
                "properties": {
                    "auth-type": {
                        "const": "basic"
                    }
                },
                "required": ["basic"]
            },
            {
                "properties": {
                    "auth-type": {
                        "const": "iam_user"
                    }
                },
                "required": ["iam_user"]
            },
            {
                "properties": {
                    "auth-type": {
                        "const": "iam_role"
                    }
                },
                "required": ["iam_role"]
            }
        ]
    }
}
