ATLAN_APP_HTTP_PORT=8000
ATLAN_APP_HTTP_HOST=0.0.0.0
ATLAN_APP_DASHBOARD_HTTP_PORT=8050
ATLAN_APP_DASHBOARD_HTTP_HOST=0.0.0.0
ATLAN_DAPR_APP_PORT=3000
ATLAN_DAPR_HTTP_PORT=3500
ATLAN_DAPR_GRPC_PORT=50001
ATLAN_DAPR_METRICS_PORT=3100
ATLAN_WORKFLOW_UI_ENABLED=true
ATLAN_WORKFLOW_HOST=127.0.0.1
ATLAN_WORKFLOW_PORT=7233
ATLAN_WORKFLOW_UI_HOST=127.0.0.1
ATLAN_WORKFLOW_UI_PORT=8233
ATLAN_WORKFLOW_METRICS_PORT=8234
ATLAN_TENANT_ID=default
ATLAN_WORKFLOW_NAMESPACE=default
ATLAN_APPLICATION_NAME=mysql
ATLAN_SQL_SERVER_MIN_VERSION=8.0
ENABLE_OTLP_LOGS=false

ATLAN_HEARTBEAT_TIMEOUT_SECONDS=120 # 2 minutes
ATLAN_START_TO_CLOSE_TIMEOUT_SECONDS=7200 # 2 hours

# MySQL server hostname or IP address
E2E_MYSQL_HOST=localhost

# MySQL server port (default: 3306)
E2E_MYSQL_PORT=3306

# MySQL username for authentication
E2E_MYSQL_USERNAME=test_user

# MySQL password for authentication
E2E_MYSQL_PASSWORD=test_password

# MySQL database name to use for testing
E2E_MYSQL_DATABASE=test_database

# ── Self-Deployed Runtime (SDR) — for `make sdr-*` targets ────────────────
# These power sdr-dev/render.sh; see sdr-dev/README.md for full reference.
# Leave unset if you don't run the SDR install — `make sdr-render` will
# fail-fast with a clear message listing what's missing.
#
# SDR_RELEASE_NAME — full helm release name. MUST start with "mysql-app-sdr-".
# Atlan-side identifiers are derived by stripping that prefix:
#   release "mysql-app-sdr-dev" → agent "mysql-dev", queue "atlan-mysql-dev".
SDR_RELEASE_NAME=mysql-app-sdr-dev
SDR_TENANT_DOMAIN=tenant.atlan.com
SDR_INSTANCE_NAME=tenant-instance
SDR_S3_BUCKET=atlan-vcluster-...
SDR_S3_REGION=ap-south-1
# Bump per-test; the image repo (atlanhq/atlan-mysql-app) is fixed in the chart.
SDR_IMAGE_TAG=main-<sha>
# SDR creds are independent of the e2e MYSQL_* creds above — they target
# whichever MySQL the SDR pod will reach (typically a different DB than the
# local testcontainers one). If you want to reuse the e2e creds, you can
# reference them: SDR_MYSQL_USERNAME="${MYSQL_USER}" etc.
SDR_MYSQL_USERNAME=
SDR_MYSQL_PASSWORD=