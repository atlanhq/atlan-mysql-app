# SDR (Self-Deployed Runtime) values override — TEMPLATE.
#
# This file is rendered by `dev/sdr/render.sh` (or `make sdr-render`) using
# values from .env. Do NOT put real credentials here — they go in .env, which
# is gitignored.
#
# Mirrors the in-cluster mysql-server topology used on devex:
# in-cluster Temporal, no Cloudflare in path, OAuth disabled.
# The chart's deployment.yaml + dapr-components-cm.yaml in dev/sdr/chart are
# patched to support this; see comments in those files.

nameOverride: "${SDR_RELEASE_NAME}"
fullnameOverride: "${SDR_RELEASE_NAME}"

deploymentName: "${SDR_DEPLOYMENT_NAME}"

global:
  atlanBaseUrl: "${SDR_TENANT_DOMAIN}"
  # Auth disabled at deployment.yaml level; clientId/Secret intentionally omitted.

image:
  # Repository is fixed for this app — only the tag is bumped per-test.
  # Atlan publishes the runtime image to GHCR (not Docker Hub).
  repository: ghcr.io/atlanhq/atlan-mysql-app
  tag: "${SDR_IMAGE_TAG}"
  pullPolicy: IfNotPresent

imagePullSecrets:
  - name: atlan-docker-secret

env:
  - name: ATLAN_INSTANCE_NAME
    value: "${SDR_INSTANCE_NAME}"
  # Read by app/mysql.py to populate MySQLExtractionOutput.storage_bucket,
  # which the manifest forwards to qi + lineage-app's cloud_storage_bucket arg.
  - name: S3_BUCKET
    value: "${SDR_S3_BUCKET}"

  # ── Credential resolution ────────────────────────────────────────────────
  # Both env-var keys and bundle keys deliberately match the .env var names
  # so contributors type the same string in .env and in the Atlan UI form.
  # Two patterns supported (pick one — comment the other out):
  #
  # PATTERN A — Single-key per-field (default; SDK ≥ BLDX-968 / 3.7+):
  # Each credential field is its own env var on the pod. Atlan UI workflow form:
  #   Secret Path: (leave empty)
  #   key-type:    single-key
  #   Username:    SDR_MYSQL_USERNAME    (env var name on the pod, resolved by secret store)
  #   Password:    SDR_MYSQL_PASSWORD
  - name: SDR_MYSQL_USERNAME
    value: "${SDR_MYSQL_USERNAME}"
  - name: SDR_MYSQL_PASSWORD
    value: "${SDR_MYSQL_PASSWORD}"
  #
  # PATTERN B — Multi-key bundle (older SDKs without single-key support):
  # The SDK fetches the JSON bundle below from the secret store and looks
  # up each Atlan-UI field value as a bundle key. Atlan UI workflow form:
  #   Secret Path / Secret Name in Secret Manager: MYSQL_SECRETS
  #   Username:                                    SDR_MYSQL_USERNAME
  #   Password:                                    SDR_MYSQL_PASSWORD
  # Then uncomment this env var (and comment out the per-field ones above):
  # - name: MYSQL_SECRETS
  #   value: '{"SDR_MYSQL_USERNAME":"${SDR_MYSQL_USERNAME}","SDR_MYSQL_PASSWORD":"${SDR_MYSQL_PASSWORD}"}'

dapr:
  components:
    # Disabled — in-cluster mysql-server doesn't use this binding either.
    # The chart's atlan_objectstore template needs OAuth client creds
    # (clientId/Secret) which we deliberately omit since
    # ATLAN_AUTH_ENABLED=false in our patched template.
    atlan_objectstore:
      enabled: false
    objectstore:
      enabled: true
      spec:
        type: bindings.aws.s3
        version: v1
        metadata:
          - name: bucket
            value: "${SDR_S3_BUCKET}"
          - name: region
            value: "${SDR_S3_REGION}"
          # accessKey/secretKey omitted intentionally — pod uses node IAM role
          # (matches existing in-cluster mysql-objectstore config).
    secretstore:
      enabled: true
      spec:
        type: secretstores.local.env
        version: v1
    deployment_secrets:
      enabled: true
      multiKeySecretPath: ""
      spec:
        type: secretstores.local.env
        version: v1
    eventstore:
      enabled: true
