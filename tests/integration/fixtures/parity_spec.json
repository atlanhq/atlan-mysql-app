{
  "_description": "Expected JSONL entity shape produced by the pyatlan_v9 asset-mapper (.creator()) pattern. Structural guard rail — relationship refs live under relationshipAttributes, not nested inside attributes; tenantId/status are not duplicated at the top level (status is top-level, tenantId is attributes-only).",
  "_note": "sdk_injected_attributes are added by the SDK framework (not app mappers) — connectionName, lastSync*",
  "sdk_injected_attributes": [
    "lastSyncWorkflowName",
    "lastSyncRun",
    "lastSyncRunAt",
    "connectionName"
  ],
  "database": {
    "top_level_keys": [
      "typeName",
      "status",
      "attributes"
    ],
    "required_attributes": [
      "name",
      "qualifiedName",
      "connectionQualifiedName",
      "connectorName",
      "schemaCount",
      "tenantId"
    ]
  },
  "schema": {
    "top_level_keys": [
      "typeName",
      "status",
      "attributes",
      "relationshipAttributes"
    ],
    "required_attributes": [
      "name",
      "qualifiedName",
      "connectionQualifiedName",
      "connectorName",
      "databaseName",
      "databaseQualifiedName",
      "tableCount",
      "viewsCount",
      "tenantId"
    ],
    "required_relationships": [
      "database"
    ]
  },
  "table": {
    "top_level_keys": [
      "typeName",
      "status",
      "attributes",
      "relationshipAttributes",
      "customAttributes"
    ],
    "required_attributes": [
      "name",
      "qualifiedName",
      "connectionQualifiedName",
      "connectorName",
      "databaseName",
      "databaseQualifiedName",
      "schemaName",
      "schemaQualifiedName",
      "columnCount",
      "sizeBytes",
      "isPartitioned",
      "partitionCount",
      "tenantId"
    ],
    "required_relationships": [
      "atlanSchema"
    ],
    "table_only_attributes": [
      "rowCount",
      "subType"
    ]
  },
  "view": {
    "top_level_keys": [
      "typeName",
      "status",
      "attributes",
      "relationshipAttributes"
    ],
    "required_attributes": [
      "name",
      "qualifiedName",
      "connectionQualifiedName",
      "connectorName",
      "databaseName",
      "databaseQualifiedName",
      "schemaName",
      "schemaQualifiedName",
      "definition",
      "description",
      "columnCount",
      "sizeBytes",
      "tenantId"
    ],
    "required_relationships": [
      "atlanSchema"
    ],
    "_note": "View has no is_partitioned/partition_count on the pyatlan_v9 model (Table-only concepts) — unlike the legacy hand-rolled shape, which set them unconditionally on both."
  },
  "column": {
    "top_level_keys": [
      "typeName",
      "status",
      "attributes",
      "relationshipAttributes",
      "customAttributes"
    ],
    "required_attributes": [
      "name",
      "qualifiedName",
      "connectionQualifiedName",
      "connectorName",
      "databaseName",
      "databaseQualifiedName",
      "schemaName",
      "schemaQualifiedName",
      "dataType",
      "isNullable",
      "isPartition",
      "isPrimary",
      "isForeign",
      "maxLength",
      "numericScale",
      "order",
      "precision",
      "tenantId"
    ],
    "conditional_attributes": {
      "table_column": [
        "tableName",
        "tableQualifiedName"
      ],
      "view_column": [
        "viewName",
        "viewQualifiedName"
      ]
    },
    "conditional_relationships": {
      "table_column": ["table"],
      "view_column": ["view"]
    }
  },
  "relationship_ref_format": {
    "database": {
      "typeName": "Database",
      "uniqueAttributes": {
        "qualifiedName": "..."
      }
    },
    "atlanSchema": {
      "typeName": "Schema",
      "uniqueAttributes": {
        "qualifiedName": "..."
      }
    },
    "table": {
      "typeName": "Table",
      "uniqueAttributes": {
        "qualifiedName": "..."
      }
    },
    "view": {
      "typeName": "View",
      "uniqueAttributes": {
        "qualifiedName": "..."
      }
    }
  }
}
